    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst formType = $('\ud83d\udccb Search Form').first().json[\"Business Type\"];\n\nconst typeMap = {\n  \"Restaurant\":\"restaurant\",\n  \"Salon\":\"salon\",\n  \"Healthcare\":\"healthcare\",\n  \"Gym\":\"gym\",\n  \"Hotel\":\"hotel\",\n  \"Pet Store\":\"pets\",\n  \"Services\":\"services\",\n  \"Retail\":\"retail\",\n  \"General\":\"general\"\n};\n\nconst category = formType ? (typeMap[formType] || 'general') : 'general';\n\nreturn items.map(item => {\n  const place = item.json;\n  const extratags = place.extratags || {};\n  const website = extratags.website || extratags.url || '';\n  const phone = extratags.phone || extratags.contact_phone || '';\n  const hasWebsite = website.length > 0;\n  \n  return {\n    json: {\n      place_id: place.place_id || '',\n      business_name: place.name || (place.display_name ? place.display_name.split(',')[0] : 'Unknown'),\n      address: place.display_name || '',\n      rating: 'N/A',\n      total_reviews: 0,\n      types: place.type || '',\n      category: category,\n      maps_url: place.osm_id ? `https://www.openstreetmap.org/node/${place.osm_id}` : '',\n      phone: phone,\n      website: website,\n      has_website: hasWebsite,\n      opening_hours: extratags.opening_hours || ''\n    }\n  };\n});\n"
      },
