    {
      "parameters": {
        "jsCode": "const lead = $('\ud83d\udd0e Parse Facebook Result').first().json;\nconst igData = $input.first().json;\nconst igUser = igData?.data?.user;\nconst hasInstagram = igUser ? true : false;\nconst instagramUrl = hasInstagram ? `https://www.instagram.com/${igUser.username}/` : '';\nconst igHasWebsite = igUser?.bio_links?.length > 0 || igUser?.external_url?.length > 0;\nconst phone = lead.phone || '';\nconst isIndianNumber = phone.includes('+91') || phone.startsWith('0');\nconst likelyHasWhatsApp = phone.length > 6 && isIndianNumber;\nlet outreachChannel = 'unknown';\nif (likelyHasWhatsApp) outreachChannel = 'whatsapp';\nelse if (lead.email) outreachChannel = 'email';\nelse outreachChannel = 'manual_check';\nconst isQualifiedLead = !lead.has_website && !lead.fb_has_website && !igHasWebsite;\nreturn [{ json: { ...lead, has_instagram: hasInstagram, instagram_url: instagramUrl, ig_has_website: igHasWebsite, likely_has_whatsapp: likelyHasWhatsApp, outreach_channel: outreachChannel, is_qualified_lead: isQualifiedLead, status: 'pending_review', added_date: new Date().toISOString().split('T')[0] } }];"
      },
